{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elections.local/schemas/release-manifest.schema.json",
  "title": "Eleições public release",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetVersion",
    "electionYear",
    "scope",
    "model",
    "origins",
    "displayGroups",
    "destinations",
    "resources",
    "provenance"
  ],
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256",
        "encoding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "encoding": {
          "enum": [
            "json",
            "gzip"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "gzip"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.json\\.bin$"
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "electionYear": {
      "type": "integer"
    },
    "scope": {
      "enum": [
        "full",
        "fixture"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "label",
        "status",
        "scenarioCount",
        "scenarios",
        "sensitivityDescription",
        "boundsDescription"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "scenarioCount": {
          "type": "integer",
          "minimum": 1
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sensitivityDescription": {
          "type": "string",
          "minLength": 1
        },
        "boundsDescription": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "origins": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "shortLabel",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "shortLabel": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "candidate",
              "blank",
              "null",
              "abstention"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "displayGroups": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "shortLabel",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "shortLabel": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "enum": [
              "lula",
              "flavio",
              "blank",
              "null",
              "abstention"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "national",
        "search",
        "states"
      ],
      "properties": {
        "national": {
          "$ref": "#/$defs/resource"
        },
        "search": {
          "$ref": "#/$defs/resource"
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/resource"
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "operation",
        "runId",
        "sources",
        "limitations"
      ]
    }
  },
  "additionalProperties": false
}
